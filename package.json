{
  "name": "obsidian-clipboard-compare",
  "version": "0.2.0",
  "private": true,
  "description": "Compare the active note with the clipboard using VS Code's diff editor.",
  "author": "Chao Wen",
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run lint && npm run build && npm test && npm run test:browser && npm run validate:release",
    "lint": "eslint src --max-warnings=0",
    "validate:release": "node scripts/validate-release.mjs"
  },
  "dependencies": {
    "monaco-editor": "0.57.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "moment": "^2.31.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "playwright": "^1.56.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.0.0"
  }
}
